<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
    <Script file="PersonalResourceDisplay.lua"/>

    <StatusBar name="PrdStatusBarTemplate" virtual="true" minValue="0" maxValue="1" defaultValue="1">
        <BarTexture file="Interface\TargetingFrame\UI-StatusBar"/>

        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="bg">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="1" y="-1"/>
                        <Anchor point="BOTTOMRIGHT" x="-1" y="1"/>
                    </Anchors>
                    <Color r="0" g="0" b="0" a="0.75"/>
                </Texture>
            </Layer>
            <Layer level="OVERLAY">
                <FontString parentKey="text" inherits="GameFontNormal">
                    <Color r="1" g="1" b="1" a="1"/>
                    <Anchors>
                        <Anchor point="CENTER"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>

        <Frames>
            <Frame parentKey="border" inherits="BackdropTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" x="-2" y="2"/>
                    <Anchor point="BOTTOMRIGHT" x="2" y="-2"/>
                </Anchors>
            </Frame>
        </Frames>

        <Scripts>
            <OnLoad method="OnLoad"/>
            <OnEvent method="OnEvent"/>
        </Scripts>
    </StatusBar>

    <Frame name="Prd" parent="UIParent" mixin="PrdMixin">
        <Size x="160" y="60"/>

        <Scripts>
            <OnLoad method="OnLoad"/>
            <OnEvent method="OnEvent"/>
            <OnEnter method="OnEnter"/>
            <OnLeave method="OnLeave"/>
        </Scripts>

        <Anchors>
            <Anchor point="TOP" relativeTo="UIParent" relativePoint="CENTER">
                <Offset x="0" y="-100"/>
            </Anchor>
        </Anchors>

        <Frames>
            <StatusBar name="PrdHealthBar" parentKey="PrdHealthBar" inherits="PrdStatusBarTemplate" mixin="PrdHealthBarMixin">
                <Size x="150" y="22"/>
                <Anchors>
                    <Anchor point="TOP" relativeTo="Prd" relativePoint="TOP">
                        <Offset x="0" y="0"/>
                    </Anchor>
                </Anchors>
                <BarColor r="0" g="1" b="0"/>
            </StatusBar>

            <StatusBar name="PrdPowerBar" parentKey="PrdPowerBar" inherits="PrdStatusBarTemplate" mixin="PrdPowerBarMixin">
                <Size x="150" y="12"/>
                <Anchors>
                    <Anchor point="TOP" relativeTo="PrdHealthBar" relativePoint="BOTTOM">
                        <Offset x="0" y="-2"/>
                    </Anchor>
                </Anchors>
                <BarColor r="0" g="0.4" b="1"/>
            </StatusBar>
        </Frames>
    </Frame>
</Ui>